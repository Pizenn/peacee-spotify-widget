{
  "name": "spotify-widget",
  "version": "1.0.0",
  "description": "Custom Spotify Desktop Widget",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build:css": "tailwindcss -i ./src/renderer/input.css -o ./src/renderer/style.css",
    "watch:css": "tailwindcss -i ./src/renderer/input.css -o ./src/renderer/style.css --watch",
    "dev": "concurrently \"npm run watch:css\" \"npm start\"",
    "build": "npm run build:css && electron-builder --win" 
  },
  "build": {
    "appId": "com.namakamu.spotifywidget",
    "productName": "Spotify Widget",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico" 
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "axios": "^1.x.x",
    "dotenv": "^16.x.x"
  },
  "devDependencies": {
    "concurrently": "^8.x.x",
    "electron": "^28.x.x",
    "electron-builder": "^24.x.x",
    "tailwindcss": "^3.x.x"
  }
}